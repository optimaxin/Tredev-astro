{
  "name": "tredevastro",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "web/frontend",
    "backend",
    "web/ganesh-chaturthi"
  ],
  "scripts": {
    "dev": "npm run dev --workspace tredevastro-frontend",
    "server": "npm run dev --workspace backend",
    "campaign": "npm run dev --workspace ganesh-chaturthi-campaign",
    "dev:all": "concurrently -n web,api -c blue,magenta \"npm:dev\" \"npm:server\"",
    "build": "npm run build --workspace tredevastro-frontend",
    "lint": "npm run lint --workspace tredevastro-frontend",
    "preview": "npm run preview --workspace tredevastro-frontend",
    "test:backend": "npm run test --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright": "^1.62.1"
  }
}
