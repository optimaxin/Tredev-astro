# Copy to .env and fill in real values. Dev-only fallbacks exist for a few
# of these (see app/core/config.ts) so local dev works without every value
# set — production requires all of them.

PORT=4000
NODE_ENV=development

# Comma-separated allowlist of origins allowed to call this API. Include
# BOTH the main site's domain AND the Ganesh Chaturthi campaign's domain
# when the campaign is deployed on its own separate domain (it always is —
# ganesh-chaturthi is its own Vite app/deployment, not served by this
# backend). Left empty, dev mode allows any localhost/127.0.0.1 origin
# regardless of port instead.
# CLIENT_ORIGIN=https://tredevastro.com,https://ganesh.tredevastro.com

# Where the campaign app (ganesh-chaturthi) is actually deployed — the
# backend's own Playwright-based PDF pipeline (kundliPdf.routes.ts) navigates
# HERE to render the Kundli report, and also fetches /logo.png and
# /images/acharya.png from this origin. Must be the campaign's real public
# URL once it's deployed separately; defaults to http://localhost:1409 for
# local dev (the campaign's own `npm run dev` port).
# CAMPAIGN_APP_URL=https://ganesh.tredevastro.com

DATABASE_URL=
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRATION=15m
REFRESH_TOKEN_TTL_DAYS=7

# Optional — geocoding falls back to the free Nominatim provider without it.
AWS_LOCATION_API_KEY=
AWS_LOCATION_REGION=us-east-1

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The whole Firebase service-account JSON, pasted as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gates GET /api/campaign-analytics/summary and the /campaign-analytics
# dashboard page (see app/api/campaignAnalytics.routes.ts) — a single shared
# password, not per-user auth. Change this before deploying; the dev
# fallback (see config.ts) is not safe to leave in production.
CAMPAIGN_ANALYTICS_PASSWORD=
