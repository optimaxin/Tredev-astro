# Backend base URL — the ONLY backend this app ever talks to (it never
# talks to the Stage 6 report service directly; that stays private behind
# the backend's /api/premium-reports proxy, see docs/premium-reports.md).
VITE_API_URL=http://localhost:4000

# Where "Back to TredevaAstro" links out to. This app has no site chrome of
# its own, so that link is an external link to the real site.
VITE_MAIN_SITE_URL=http://localhost:5173
