{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* include reaches outside "src" on purpose: several files under
     ../frontend/src are imported directly by relative path (see
     vite.config.ts's comment) and need to be in scope for type-checking. */
  "include": ["src", "../frontend/src/components/BirthDetailsForm/**/*", "../frontend/src/components/AncientDatePicker/**/*", "../frontend/src/components/AncientTimePicker/**/*", "../frontend/src/components/LocationAutocomplete/**/*", "../frontend/src/components/Icons/**/*", "../frontend/src/services/calculatorService.ts", "../frontend/src/services/authService.ts", "../frontend/src/services/apiUrl.ts", "../frontend/src/services/premiumReportService.ts", "../frontend/src/utils/reportMarkdown.ts"]
}
