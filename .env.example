# Database (Prisma). Dev default is a local SQLite file — no setup needed.
# For production, create a Postgres database (Neon/Supabase both work) and:
#   1. switch `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
#   2. install @prisma/adapter-pg and swap the adapter in src/lib/db.ts + prisma/seed.ts
#   3. set DATABASE_URL below to the real connection string
#   4. run `npx prisma migrate deploy`
DATABASE_URL="file:./dev.db"

# Session signing secret for the phone-OTP login (src/lib/auth.ts). Any long
# random string — generate one with `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-string"

# --- Not yet wired, needed to go fully live ---

# SMS provider for OTP delivery (src/lib/auth.ts currently just logs the
# code to the server console). Pick one and wire it into requestOtp():
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Live voice/video calling provider (src/app/api/consultation/[id]/token).
# Pick one — Agora, 100ms, or Twilio Video all work for 1:1 astrology calls.
# CALL_PROVIDER_APP_ID=
# CALL_PROVIDER_APP_SECRET=

# Payment gateway (src/app/api/wallet/topup, src/app/api/bookings currently
# stub-credit/stub-pay with no real charge). Razorpay is the natural fit for
# India-focused ₹ pricing.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
